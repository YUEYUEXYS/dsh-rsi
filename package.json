{
  "name": "dsh-rsi",
  "version": "0.1.0",
  "description": "DSH prompt-policy evolution with per-route evidence and strict promotion.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YUEYUEXYS/dsh-rsi.git"
  },
  "homepage": "https://github.com/YUEYUEXYS/dsh-rsi",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "rsi",
    "prompt-evolution",
    "llm"
  ],
  "type": "module",
